<Project Sdk="Microsoft.NET.Sdk">

  <!-- No external packages: only the .NET 8 base class libraries, so the
       verifier builds offline. Row dumping goes through the sqlite3 CLI
       (a dumb pipe); all chain logic is reimplemented below. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
